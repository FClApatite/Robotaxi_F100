--cpu Cortex-M3
"dl2\startup_stm32f100xb.o"
"dl2\main.o"
"dl2\gpio.o"
"dl2\adc.o"
"dl2\tim.o"
"dl2\usart.o"
"dl2\stm32f1xx_it.o"
"dl2\stm32f1xx_hal_msp.o"
"dl2\stm32f1xx_hal_gpio_ex.o"
"dl2\stm32f1xx_hal_adc.o"
"dl2\stm32f1xx_hal_adc_ex.o"
"dl2\stm32f1xx_hal.o"
"dl2\stm32f1xx_hal_rcc.o"
"dl2\stm32f1xx_hal_rcc_ex.o"
"dl2\stm32f1xx_hal_gpio.o"
"dl2\stm32f1xx_hal_dma.o"
"dl2\stm32f1xx_hal_cortex.o"
"dl2\stm32f1xx_hal_pwr.o"
"dl2\stm32f1xx_hal_flash.o"
"dl2\stm32f1xx_hal_flash_ex.o"
"dl2\stm32f1xx_hal_exti.o"
